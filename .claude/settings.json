{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm test *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-bash-output.py\""
          },
          {
            "type": "command",
            "if": "Bash(npm run test:e2e *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-bash-output.py\""
          },
          {
            "type": "command",
            "if": "Bash(python* .harness/runtime/harness.py check *)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-bash-output.py\""
          }
        ]
      }
    ]
  }
}
